# Copy to .env and adjust. Values shown are the defaults unless noted.
# Optional and secret entries are commented out: a blank value is read as an
# empty string, not as unset, so leave a line commented until you set it.

# --- App ---
APP_NAME=smart-weather
DATABASE_URL=sqlite://smart_weather.sqlite3
# Apply pending migrations at startup; leave off with several workers/replicas
# and run `python -m app.cli migrate` as a deploy step instead
RUN_DB_MIGRATIONS_ON_STARTUP=false
# Create missing tables from the models, bypassing migrations (throwaway DBs only)
GENERATE_DB_SCHEMAS=false
WEATHER_CLIENT_TIMEOUT=10.0
# Trusted external origin when deployed behind a proxy (used in OAuth metadata)
# PUBLIC_BASE_URL=https://weather.example.com

# --- Weather history ---
# Clients see only their own lookups from the last N days; older rows are
# deleted in batches of this size whenever a new lookup is saved.
WEATHER_HISTORY_RETENTION_DAYS=30
WEATHER_HISTORY_PRUNE_BATCH_SIZE=500

# --- OAuth token lifetimes (seconds) ---
ACCESS_TOKEN_TTL_SECONDS=900
AUTHORIZATION_CODE_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- AI agent (POST /ai/ask) ---
# LangChain "provider:model" string, e.g. openai:gpt-4o-mini. Other providers
# also need their langchain-<provider> package installed.
AI_MODEL=openai:gpt-4o-mini
# Used for openai: models
# OPENAI_API_KEY=
# Overrides OPENAI_API_KEY; use for any other provider
# AI_API_KEY=
AI_TEMPERATURE=0.0
AI_MAX_OUTPUT_TOKENS=1024
# Per model call, in seconds
AI_TIMEOUT=30.0
AI_MAX_RETRIES=1
# Whole /ai/ask run, in seconds
AI_REQUEST_TIMEOUT=60.0
# Agent graph recursion limit (each model call and tool round is one step)
AI_MAX_STEPS=8
# Max concurrent /ai/ask runs per process; excess requests get 429
AI_MAX_CONCURRENCY=10

# --- LangSmith tracing (off by default) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-weather
# EU region: https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=
# Traces include questions and answers; redact them if sensitive
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
